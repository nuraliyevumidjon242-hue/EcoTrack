# EcoTrack local configuration
PROJECT_NAME="EcoTrack - Smart Energy & Asset Management System"
ENVIRONMENT=development
SECRET_KEY=replace_with_a_random_64_character_hex_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local development uses SQLite. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./ecotrack.db

# Docker Compose values; replace the password with a unique random 64-character hex value.
POSTGRES_USER=ecotrack_admin
POSTGRES_PASSWORD=replace_with_a_random_64_character_hex_password
POSTGRES_DB=ecotrack_prod
